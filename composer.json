{
    "name": "theriddleofenigma/laravel-model-validation",
    "description": "Effortless, self-contained validation for your Eloquent models.",
    "keywords": [
        "laravel",
        "eloquent",
        "model",
        "validation",
        "validator"
    ],
    "homepage": "https://github.com/theriddleofenigma/laravel-model-validation",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Kumaravel",
            "email": "kumarwindows11@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/contracts": "^11.0|^12.0|^13.0",
        "illuminate/database": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "illuminate/validation": "^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^10.5|^11.5|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Enigma\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Enigma\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "test:coverage": "vendor/bin/phpunit --coverage-text"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
